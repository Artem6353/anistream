# Python-bridge (kodik | multi): ARG BRIDGE=kodik_bridge.py|multi_player_bridge.py
FROM python:3.12-slim
WORKDIR /bridge
RUN pip install --no-cache-dir requests beautifulsoup4 lxml \
 && pip install --no-cache-dir https://github.com/YaNesyTortiK/AnimeParsers/archive/refs/heads/main.zip
COPY bridges/ ./bridges/
ARG BRIDGE=kodik_bridge.py
ENV BRIDGE=${BRIDGE}
CMD ["sh", "-c", "python bridges/${BRIDGE}"]
