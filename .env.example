# ============================================================
# AniStream 2.x — пример конфигурации окружения
# Скопируйте в .env.local и заполните. .env.local НЕ коммитить!
# Схема совместима с .env.example исходного проекта.
# ============================================================

# ---------- Брендирование / SEO ----------
NEXT_PUBLIC_SITE_NAME=AniNova
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Аудит 2026-10 (ТЗ 3.2.2): подтверждение Яндекс.Вебмастера мета-тегом.
# Пусто = тег не выводится. Google-верификация уже зашита в app/layout.tsx.
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Необязательно: абсолютный путь логотипа для JSON-LD Organization (/logo-icon.svg).
NEXT_PUBLIC_SITE_LOGO=

# ---------- Каталог: источник данных (аудит 2026-10, ТЗ 2.1) ----------
# db  — читать каталог из Supabase public.titles (нужны NEXT_PUBLIC_SUPABASE_URL
#       и SUPABASE_SERVICE_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY);
# file — только lib/data/titles.json (прежнее поведение).
# Пусто = db, если Supabase настроен, иначе file. До проверки smoke держите file.
# Наполнение таблицы: node scripts/import-titles-to-db.mjs
CATALOG_SOURCE=
# Сколько страниц тайтлов предрендерить на сборке (остальные — on-demand ISR).
# Замер: 120 страниц собираются в 1 ГБ RAM/heap 700 МБ; на билд-машине Vercel можно выше.
STATIC_TITLE_LIMIT=120
# Предрендер страниц серий. По умолчанию 0: даже 10 страниц серий роняют сборку
# в «Reached heap limit» (страница тянет тяжёлый PlayerShell + hls.js).
STATIC_EPISODE_TITLE_LIMIT=0

# ---------- Плеер: что считать источником (аудит 2026-10, ТЗ 1.6) ----------
# Демо-поток (публичные тестовые MP4 Google). На ПРОДЕ по умолчанию выключен:
# раньше флаг default=true, и при отсутствии источников плеер показывал Big Buck Bunny.
DEMO_PROVIDER_ENABLED=
# Синтез URL по шаблону и «подбор пулом озвучек». На проде по умолчанию выключено:
# это непроверенные ссылки, а зелёная точка выдавала их за доступный источник.
# Выключение даёт честное «Источников пока нет» (lib/source-hints.ts).
PROVIDER_UNVERIFIED_FALLBACK=
# Автоподбор ПУБЛИЧНОГО токена Kodik (getPublicToken) — только dev-утилита.
# В продакшен-пути не используется: нужен собственный KODIK_TOKEN.
KODIK_ALLOW_PUBLIC_TOKEN=
# Блок «Где смотреть легально» на странице тайтла (юридическое замечание ТЗ).
# По умолчанию выключен; наполнение — поле legalWatch тайтла (см. LegalWatchBlock.tsx).
LEGAL_WATCH_ENABLED=

# ---------- Индексация пустых разделов (ТЗ 1.7.4) ----------
# Лента/клубы/форум индексируются, когда записей не меньше порога.
SECTION_INDEX_THRESHOLD=10
# Сколько тайтлов обходить при сборке sitemap/3.xml (страницы серий с источниками).
SITEMAP_EPISODE_TITLES=500
# Прокси картинок: 0 — отключить встроенный /img?url= (по умолчанию включён, FS-кэш)
NEXT_PUBLIC_IMG_PROXY=

# ---------- Админ-панель (A9/W4) ----------
# Токен входа в /admin. Сгенерируйте свой:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# ---------- Источники видео ----------
# DEMO_PROVIDER_ENABLED — см. блок «Плеер: что считать источником» выше
# (на проде по умолчанию выключен).
KODIK_ENABLED=true
ANIBOOM_ENABLED=false
ANIBOOM_TOKEN=

# Kodik (kodikwrapper): токен, зеркало API, таймауты.
# Аудит 2026-10 (ТЗ 1.6.6): нужен СОБСТВЕННЫЙ токен — его выдаёт Kodik разработчикам.
# Без токена провайдер отключается без ошибок (автоподбор публичных токенов в проде
# выключен, см. KODIK_ALLOW_PUBLIC_TOKEN выше).
KODIK_TOKEN=
KODIK_API_BASE_URL=https://kodik-api.com
KODIK_TIMEOUT_MS=5000
KODIK_EPISODE_SEARCH_LIMIT=10

# ---------- Кэш резолвов провайдеров ----------
PROVIDER_CACHE_ENABLED=true
PROVIDER_CACHE_WRITE=true
KODIK_CACHE_TTL_MS=86400000
KODIK_CACHE_FILE=.cache/providers-resolve-cache.json
PROVIDER_CACHE_WRITE_DEBOUNCE_MS=5000
# Опционально: Upstash Redis (бессерверный KV-кэш вместо файлового)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Метаданные ----------
SHIKIMORI_ENABLED=true
# User-Agent для Shikimori/AniList API (обязательно укажите свой контакт)
SHIKIMORI_USER_AGENT=AniStream/2.0 (your@email.example)

# ---------- Тайминги OP/ED (Kodik skipButtons → AniSkip fallback) ----------
ANISKIP_ENABLED=true

# ---------- Python-bridge (локальные или удалённые за Caddy — A0.1) ----------
# kodik_bridge.py → :8765, multi_player_bridge.py → :8766
# Локально допустимы адреса 127.0.0.1:8765/8766.
# В Vercel loopback-адреса намеренно отключены: задайте реальные доступные URL удалённого bridge.
# В проде за реверс-прокси: https://bridge.вашдомен (deploy/Caddyfile) + BRIDGE_TOKEN
KODIK_BRIDGE_URL=http://127.0.0.1:8765
KODIK_BRIDGE_TIMEOUT_MS=6000
MULTIPLAYER_BRIDGE_URL=http://127.0.0.1:8766
MULTIPLAYER_BRIDGE_TIMEOUT_MS=6000
# Bearer-токен доступа к bridge (совпадает с $BRIDGE_TOKEN в deploy/Caddyfile).
# Аудит 30.09 (P1-9): токен проверяют САМИ bridge'и (hmac.compare_digest) — задавайте
# его ОБЯЗАТЕЛЬНО, если BRIDGE_HOST != 127.0.0.1 (docker-compose ставит 0.0.0.0).
# Адрес интерфейса bridge (по умолчанию 127.0.0.1; в контейнере — 0.0.0.0).
BRIDGE_HOST=127.0.0.1
BRIDGE_TOKEN=

# Все включённые плееры ищутся параллельно и объединяются в один список.
PROVIDER_TIMEOUT_MS=8000

# ---------- Отзывы / комментарии / аккаунты (Supabase, опционально — A3.1/C2) ----------
# Без этой группы отзывы/списки работают локально (localStorage) и не защищены RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role-ключ: ТОЛЬКО серверная сторона (edge-функция submit-review, воркеры
# scripts/sync-airing.mjs, sync-episodes.mjs, sync-sources.mjs, import-titles-to-db.mjs).
# В клиентский бандл не попадает; НИКОГДА не добавляйте префикс NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=
# Cloudflare Turnstile (защита POST-отзывов от ботов). Задавайте ОБА значения вместе:
# secret проверяется сервером, site key рендерит виджет в форме (иначе отзывы не отправятся).
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Аудит 30.09 (P0-3): ОТДЕЛЬНЫЙ секрет HMAC-капчи отзывов. Без него в production
# капча fail-closed (отзывы отклоняются) — раньше использовался хардкод из репозитория.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CAPTCHA_SECRET=

# ---------- Пуш-уведомления (Web Push, опционально) ----------
# Сгенерировать: node scripts/send-push.mjs --gen-vapid
VAPID_PUBLIC=
VAPID_PRIVATE=
PUSH_CONTACT=mailto:your@email.example

# ---------- Мониторинг / алерты (A7, опционально) ----------
# Telegram-бот для алертов (/api/health падений, ошибок)
TG_BOT_TOKEN=
TG_CHAT_ID=
# Sentry (frontend + backend)
NEXT_PUBLIC_SENTRY_DSN=
# Внешняя аналитика (Plausible/Umami — src скрипта + домен)
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# S5: Яндекс.Метрика — числовой ID счётчика. Пусто = счётчик не подключается.
# При установленном ID next.config.ts добавляет https://mc.yandex.ru в CSP
# (script-src/connect-src/frame-src). Цели: pageview автоматически, «search» — из SearchForm.
NEXT_PUBLIC_METRIKA_ID=
