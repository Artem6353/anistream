# Caddy на VPS: bridge за bearer-токеном (A0.1a)
# Аудит 30.09: BRIDGE_TOKEN ОБЯЗАТЕЛЕН — при пустом значении матчер совпадёт с
# любым заголовком "Bearer " (пустой токен). Сами bridge'и теперь тоже проверяют
# токен (BRIDGE_TOKEN в их env) — это второй контур защиты.
bridge.example.com {
  @authed {
    header Authorization "Bearer {$BRIDGE_TOKEN}"
  }
  handle @authed {
    reverse_proxy /kodik/* 127.0.0.1:8765 {
      uri strip_prefix /kodik
    }
    reverse_proxy /multi/* 127.0.0.1:8766 {
      uri strip_prefix /multi
    }
  }
  handle {
    respond 401
  }
}
